# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tododb?retryWrites=true&w=majority

# JWT secret - generate a long random string for production
JWT_SECRET=replace_this_with_a_long_random_string

# Port the Express server listens on (behind your AWS reverse proxy / security group)
PORT=5000

# Comma-separated list of allowed frontend origins (your AWS domain / IP)
CLIENT_ORIGIN=http://localhost:3000

# Timezone for the daily 9am reset job (IANA tz name)
RESET_TZ=Asia/Kolkata

# Google OAuth credentials (Google Cloud Console -> APIs & Services -> Credentials)
# Used ONLY to let each user connect their OWN Google account via consent
# screen and create Calendar reminder events. Never store a Gmail password.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback
