# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tododb?retryWrites=true&w=majority

# JWT secret - generate a long random string for production
JWT_SECRET=replace_this_with_a_long_random_string

# Port the Express server listens on. Keep the React dev server on 3000.
PORT=3001

# API routes are versioned under /api/v1. Legacy /api routes remain available
# during migration. The frontend automatically appends /v1 when this URL ends in /api.

# Comma-separated list of allowed frontend origins (your AWS domain / IP)
CLIENT_ORIGIN=http://localhost:3000

# Google OAuth credentials (Google Cloud Console -> APIs & Services -> Credentials)
# Used ONLY to let each user connect their OWN Google account via consent
# screen and create Calendar reminder events. Never store a Gmail password.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Public URL where this backend can be reached. Do not use localhost in production.
APP_BASE_URL=http://localhost:3001
# Optional exact override. Usually APP_BASE_URL is enough.
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback

# Private S3 file storage. Prefer an IAM role in production. For local
# development, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY can be supplied.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-private-bucket-name

# GitHub OAuth App for personal and organization activity tracking.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
